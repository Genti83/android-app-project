<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".MainActivity">

    <!-- Welcome TextView -->
    <TextView
        android:id="@+id/tvWelcome"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/welcome_message"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textAlignment="center"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Status Label -->
    <TextView
        android:id="@+id/tvStatusLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/status_label"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/tvWelcome"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Status TextView -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/status_ok"
        android:textSize="14sp"
        android:textColor="#4CAF50"
        android:layout_marginStart="8dp"
        app:layout_constraintTop_toTopOf="@id/tvStatusLabel"
        app:layout_constraintBottom_toBottomOf="@id/tvStatusLabel"
        app:layout_constraintStart_toEndOf="@id/tvStatusLabel"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Test App Button -->
    <Button
        android:id="@+id/btnTestApp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/button_test_app"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/tvStatusLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Test Error Button -->
    <Button
        android:id="@+id/btnTestError"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/button_test_error"
        android:backgroundTint="#FF5722"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/btnTestApp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Test Permission Button -->
    <Button
        android:id="@+id/btnTestPermission"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/button_test_permission"
        android:backgroundTint="#FF9800"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/btnTestError"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Clear Logs Button -->
    <Button
        android:id="@+id/btnClearLogs"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/button_clear_logs"
        android:backgroundTint="#607D8B"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/btnTestPermission"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Log Output ScrollView -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:background="#F5F5F5"
        android:padding="8dp"
        app:layout_constraintTop_toBottomOf="@id/btnClearLogs"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvLogOutput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/log_output"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:textColor="#212121" />

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
